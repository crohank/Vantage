          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewFilingOut"
                  },
                  "title": "Response Sweep Now Watchlist Poller Sweep Post"
                }
              }
            }
          },
          "422": {
