{
  "openapi": "3.1.0",
  "info": {
    "title": "Vantage",
    "summary": "Finds what changed in SEC filings, and whether anyone noticed.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
