    "/analyses/{job_id}/stream": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "Stream Analysis",
        "description": "Server-sent events for one run.\n\nThe stream always terminates with a `complete` or `error` event, so a\nclient never has to guess whether a silent connection means work in\nprogress or a dead backend.",
        "operationId": "stream_analysis_analyses__job_id__stream_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyses/{job_id}/sections/{accession}/{section_id}": {
      "get": {
        "tags": [
          "filings"
        ],
        "summary": "Get Section",
        "description": "The stored text a finding's span points into.\n\nThis is what makes a citation checkable in the UI: the client resolves\nstart and end against exactly the text the engine diffed.",
        "operationId": "get_section_analyses__job_id__sections__accession___section_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
