  },
  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "company_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Name"
          },
          "cik": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cik"
          },
          "sic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sic"
          },
          "current_filing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Filing"
              },
              {
                "type": "null"
              }
            ]
          },
          "prior_filing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Filing"
              },
              {
                "type": "null"
              }
            ]
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingOut"
            },
            "type": "array",
            "title": "Findings"
          },
          "attention": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AttentionScore"
              },
              {
                "type": "null"
              }
            ]
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          },
          "timings": {
            "items": {
              "$ref": "#/components/schemas/NodeTimingOut"
            },
            "type": "array",
            "title": "Timings"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "ticker",
          "status",
          "company_name",
          "cik",
          "sic",
          "current_filing",
          "prior_filing",
          "findings",
          "attention",
          "errors",
          "timings"
        ],
        "title": "AnalysisResult",
        "description": "A completed run.\n\n`errors` is populated rather than hidden. Partial failure is visible to\nthe caller instead of being swallowed into a plausible-looking default,\nwhich is how a hardcoded sentiment string shipped in every memo for the\nlife of the previous system."
      },
      "AnalyzeRequest": {
        "properties": {
          "ticker": {
            "type": "string",
            "pattern": "^[A-Za-z]{1,5}(-[A-Za-z]{1,2})?$",
            "title": "Ticker",
            "description": "US-listed ticker, for example AAPL"
          },
          "kind": {
            "$ref": "#/components/schemas/RequestKind",
            "default": "full"
          },
          "max_sections": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Max Sections",
            "default": 4
          }
        },
        "type": "object",
        "required": [
          "ticker"
        ],
        "title": "AnalyzeRequest"
      },
      "AttentionScore": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "window_days": {
            "type": "integer",
            "title": "Window Days"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/AttentionSignal"
            },
            "type": "array",
            "title": "Signals"
          },
          "available_sources": {
            "items": {
              "$ref": "#/components/schemas/AttentionSourceName"
            },
            "type": "array",
            "title": "Available Sources",
            "readOnly": true
          },
          "total_mentions": {
            "type": "integer",
            "title": "Total Mentions",
            "readOnly": true
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Attention in [0, 1], from the mean z-score across live sources.\n\nA logistic squash keeps a single viral source from saturating the\nresult while still separating \"quiet\" from \"loud\".",
            "readOnly": true
          },
          "net_sentiment": {
            "type": "number",
            "title": "Net Sentiment",
            "readOnly": true
          },
          "is_degraded": {
            "type": "boolean",
            "title": "Is Degraded",
            "description": "True when some configured source failed, so the score understates.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "window_days",
          "signals",
          "available_sources",
          "total_mentions",
          "score",
          "net_sentiment",
          "is_degraded"
        ],
        "title": "AttentionScore",
        "description": "Aggregate across whatever sources were available."
      },
      "AttentionSignal": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/AttentionSourceName"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "window_days": {
            "type": "integer",
            "title": "Window Days"
          },
          "mention_count": {
            "type": "integer",
            "title": "Mention Count"
          },
          "baseline_daily_mean": {
            "type": "number",
            "title": "Baseline Daily Mean"
          },
          "baseline_daily_stdev": {
            "type": "number",
            "title": "Baseline Daily Stdev"
          },
          "sentiment_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Sentiment"
            },
            "type": "object",
            "title": "Sentiment Counts"
          },
          "sampled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sampled At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "readOnly": true
          },
          "z_score": {
            "type": "number",
            "title": "Z Score",
            "description": "Standard deviations above the ticker's own baseline.\n\nGuarded against a zero stdev, which happens for quiet tickers where\nevery day in the baseline window had the same count.",
            "readOnly": true
          },
          "net_sentiment": {
            "type": "number",
            "title": "Net Sentiment",
            "description": "Positive share minus negative share, in [-1, 1]. 0 when unknown.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "source",
          "ticker",
          "window_days",
          "mention_count",
          "baseline_daily_mean",
          "baseline_daily_stdev",
          "sentiment_counts",
          "sampled_at",
          "error",
          "available",
          "z_score",
          "net_sentiment"
        ],
        "title": "AttentionSignal",
        "description": "One source's reading for one ticker over one window."
      },
      "AttentionSourceName": {
        "type": "string",
        "enum": [
          "bluesky",
          "hackernews",
          "reddit",
          "news"
        ],
        "title": "AttentionSourceName"
      },
      "ChangeType": {
        "type": "string",
        "enum": [
          "added",
          "removed",
          "reworded",
          "moved"
        ],
        "title": "ChangeType"
      },
      "Filing": {
        "properties": {
          "accession": {
            "type": "string",
            "title": "Accession"
          },
          "cik": {
            "type": "string",
            "title": "Cik"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "form": {
            "$ref": "#/components/schemas/Form"
          },
          "filing_date": {
            "type": "string",
            "format": "date",
            "title": "Filing Date"
          },
          "period_of_report": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Of Report"
          },
          "primary_doc_url": {
            "type": "string",
            "title": "Primary Doc Url"
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "char_length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Char Length"
          },
          "fiscal_label": {
            "type": "string",
            "title": "Fiscal Label",
            "description": "Human label used to describe which filing a finding came from.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "accession",
          "cik",
          "ticker",
          "form",
          "filing_date",
          "primary_doc_url",
          "fiscal_label"
        ],
        "title": "Filing"
      },
      "FindingKind": {
        "type": "string",
        "enum": [
          "diff",
          "novelty",
