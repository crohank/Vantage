    "/watchlist/poller/sweep": {
      "post": {
        "tags": [
          "watchlist"
        ],
        "summary": "Sweep Now",
        "description": "Run one sweep immediately, rather than waiting for the interval.",
        "operationId": "sweep_now_watchlist_poller_sweep_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
