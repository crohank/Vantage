# Copy to .env and fill in. Only the two REQUIRED entries are needed to boot.

# ---------------------------------------------------------------- REQUIRED

# MongoDB Atlas connection string. Nothing runs without it.
# The M0 free tier is enough, but note it allows only 3 search indexes total
# and Atlas Search and Vector Search both count against that limit.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# SEC fair-access policy requires a real contact address here, and SEC's bot
# detection is strict about the shape. Measured: "Jane Doe jane@herdomain.com"
# works; "Vantage/0.1 (jane@x.com)" and any noreply domain get a 403 from
# data.sec.gov and www.sec.gov. Two space-separated parts, real domain.
SEC_EDGAR_USER_AGENT=Your Name you@yourdomain.com

# ---------------------------------------------------------------- LLM

# Generation and the primary judge.
GEMINI_API_KEY=

# Second judge, deliberately a different vendor. Judging Gemini output with
# Gemini measures self-preference as much as quality. Free tier at
# https://console.groq.com
GROQ_API_KEY=

# Optional third provider.
HUGGINGFACE_API_KEY=

# ------------------------------------------------------- ATTENTION SOURCES
# All optional. The attention layer reports which sources were live and
# degrades rather than failing when one is missing.

# Bluesky. Free and open. Use an app password, not your account password:
# Settings > Privacy and Security > App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit. Free for non-commercial use at 100 queries/minute, but self-serve
# registration closed in late 2025, so new API clients go through manual
# approval that can be refused. Treated as additive for that reason.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vantage/0.1

# News. Free tiers, tight daily caps, so responses are cached aggressively.
#   Finnhub    60 calls/min   https://finnhub.io
#   Marketaux  100 calls/day  https://marketaux.com
#   GNews      free tier      https://gnews.io
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
GNEWS_API_KEY=

# Hacker News needs no key.

# ------------------------------------------------------------ OBSERVABILITY

# Langfuse free Hobby tier, or self-hosted. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------- SERVICE

# Shared secret for the write endpoints. Leave blank to run without auth
# locally. Set it in production: the previous version had no auth on any
# route, including an unauthenticated upload that spawned a subprocess.
VANTAGE_API_KEY=
VANTAGE_CORS_ORIGINS=http://localhost:5173
VANTAGE_RATE_LIMIT=60/minute
VANTAGE_MAX_CONCURRENT_JOBS=2

# --------------------------------------------------------------- RETRIEVAL
# Defaults are sized for Render's 512 MB free tier, which also has to hold
# FastAPI, pandas and numpy. Sizes are the fastembed on-disk footprint.
#   BAAI/bge-small-en-v1.5        384d  0.067 GB  (default)
#   BAAI/bge-base-en-v1.5         768d  0.21  GB  (A/B candidate, local only)
# VANTAGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VANTAGE_EMBEDDING_DIM=384
#   jinaai/jina-reranker-v1-turbo-en  0.15 GB  (default)
#   BAAI/bge-reranker-base            1.04 GB  (does not fit the free tier)
# VANTAGE_RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
FASTEMBED_CACHE_PATH=.cache/fastembed

# ---------------------------------------------------------------- FRONTEND
# Build-time base URL for the Vite app. Must be set in the Vercel dashboard
# or the deployed frontend fetches HTML from itself and dies on JSON.parse.
VITE_API_URL=http://localhost:8000
